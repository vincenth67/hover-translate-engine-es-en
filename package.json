{
  "name": "hover-translate-engine-es-en",
  "version": "0.2.2",
  "description": "Spanish to English translation engine using Helsinki model with context-aware semicolon technique",
  "main": "dist/hover-translate-engine.js",
  "module": "src/engine.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/hover-translate-engine.js",
      "require": "./dist/hover-translate-engine.js"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:perf": "node ./scripts/test_translation_performance.js",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "test:bundle": "node tests/webpack-bundle.cjs",
    "test:translation": "node scripts/test-bundle.cjs",
    "prebuild": "node scripts/clean-dist.js",
    "postbuild": "node scripts/cleanup-dist.js && node scripts/check-bundle.js"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "tests/coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@huggingface/transformers$": "<rootDir>/tests/__mocks__/@huggingface/transformers.js"
    },
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [],
    "automock": false,
    "resetMocks": false,
    "clearMocks": true,
    "restoreMocks": true,
    "testTimeout": 10000,
    "maxWorkers": 1
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "babel-loader": "^9.2.1",
    "jest": "^29.0.0",
    "vince-dev-tools": "github:vincenth67/vince-dev-tools",
    "webpack": "^5.101.0",
    "webpack-cli": "^5.1.4"
  }
}